{
  "name": "larper-48",
  "version": "1.0.0",
  "description": "Larper 48 - a detailed 3D high-rise life sim (Three.js, WebGL2)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "build": "node build.mjs",
    "app": "node build.mjs && electron .",
    "app:dev": "node build.mjs && electron . --enable-logging",
    "package": "node package.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/regression.mjs",
    "test:save": "node tools/savetest.mjs",
    "test:play": "node tools/playtest.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.63.0",
    "three": "0.170.0"
  },
  "main": "electron/main.cjs",
  "productName": "Larper 48"
}
